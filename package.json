{
  "name": "astrax-launcher",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:a11y": "node tests/accessibility.mjs && node tests/theme-contrast.mjs",
    "test:dusk": "node tests/dusk.mjs",
    "test:motion": "node tests/motion.mjs",
    "test:extended": "node tests/extended.mjs",
    "test:panorama": "node tests/panorama.mjs",
    "test:ui": "node tests/ui-polish.mjs",
    "test:profiles": "node tests/profiles.mjs",
    "vendor:skins": "esbuild tools/skinview-entry.js --bundle --format=esm --minify --legal-comments=linked --outfile=site/vendor/skinview3d-3.4.2.js",
    "test:featured": "node tests/featured.mjs",
    "test:player": "node tests/player.mjs",
    "test:premium": "node tests/premium.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@sparticuz/chromium": "141.0.0",
    "esbuild": "0.25.12",
    "skinview3d": "3.4.2"
  }
}
